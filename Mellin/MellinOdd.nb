             "matrices", " ", "into", " ", "a", " ", "single", " ", "list", " ",
             "of", " ", 
            RowBox[{"{", 
             RowBox[{"x", ",", "y"}], "}"}], " ", "pairs"}], "*)"}], "]"}]}], 
        ";", "\[IndentingNewLine]", "\n", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Extracted \>\"", ",", 
