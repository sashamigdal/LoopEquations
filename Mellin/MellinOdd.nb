Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"OddFactor", "[", "p_", "]"}], ":=", 
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"2", "^", 
        RowBox[{"(", 
         RowBox[{"-", 
          RowBox[{"(", 
           RowBox[{"p", "+", 
            RowBox[{"17", "/", "2"}]}], ")"}]}], ")"}]}]}], ")"}]}]}], ";"}], 
  "\n"}]], "Input",
 CellChangeTimes->{{3.9922860568907003`*^9, 3.992286064142227*^9}},
 CellLabel->"In[47]:=",ExpressionUUID->"735fb22b-5469-42c5-b4d2-6f3223e18fc3"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"EulerMellin", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"finterp", "[", "x", "]"}], 
     RowBox[{"(", 
      FractionBox[
       RowBox[{
        RowBox[{"Gamma", "[", 
         RowBox[{"-", "p"}], "]"}], " ", 
        RowBox[{"Zeta", "[", 
         RowBox[{
          FractionBox["15", "2"], "+", "p"}], "]"}], 
        RowBox[{"OddFactor", "[", "p", "]"}]}], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"7", "+", 
          RowBox[{"2", " ", "p"}]}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"17", "+", 
          RowBox[{"2", " ", "p"}]}], ")"}], " ", 
        RowBox[{"Zeta", "[", 
         RowBox[{
          FractionBox["17", "2"], "+", "p"}], "]"}]}]], ")"}]}], "/.", 
    RowBox[{"p", "->", 
     RowBox[{
      RowBox[{"-", "3"}], " ", "+", " ", 
      RowBox[{"I", " ", "x"}]}]}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.98717123159865*^9, 3.9871713219149923`*^9}, {
  3.992286082317247*^9, 3.992286085256825*^9}},
 CellLabel->"In[48]:=",ExpressionUUID->"02c0a14d-7483-45d8-bc29-8e8a439d2ba2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ftab1", " ", "=", " ", 
   RowBox[{"ParallelTable", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", ",", " ", 
       RowBox[{"DF", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "7.5"}], "+", " ", 
          RowBox[{"I", " ", "x"}]}], ",", "0"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "10"}], ",", "10", ",", "0.01"}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
