Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Safety", " ", "check"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", "p0Values", "]"}], " ", "!=", " ", 
       RowBox[{"Length", "[", "thimbleData", "]"}]}], ",", "\n", "  ", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Mismatch: \>\"", ",", " ", 
         RowBox[{"Length", "[", "p0Values", "]"}], ",", 
         " ", "\"\< p0 values vs \>\"", ",", " ", "\n", "    ", 
         RowBox[{"Length", "[", "thimbleData", "]"}], ",", 
         " ", "\"\< thimbles. Adjusting...\>\""}], "]"}], ";", "\n", "  ", 
       RowBox[{"p0Values", " ", "=", " ", 
        RowBox[{"p0Values", "[", 
         RowBox[{"[", 
          RowBox[{";;", " ", 
           RowBox[{"Length", "[", "thimbleData", "]"}]}], "]"}], "]"}]}], 
       ";"}]}], "\n", "]"}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Count", " ", "trapped", " ", "poles"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"nTrappedList", " ", "=", " ", 
     RowBox[{"Table", "[", "\n", "  ", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"pFunc", " ", "=", " ", 
           RowBox[{"thimbleData", "[", 
            RowBox[{"[", "k", "]"}], "]"}]}], "}"}], ",", "\n", "    ", 
         RowBox[{"Which", "[", "\n", "      ", 
          RowBox[{
           RowBox[{
            RowBox[{"Head", "[", "pFunc", "]"}], " ", "=!=", " ", 
            "InterpolatingFunction"}], ",", " ", 
           RowBox[{"-", "1"}], ",", "\n", "      ", "True", ",", " ", 
           RowBox[{"Length", "[", 
            RowBox[{"CountTrappedPoles", "[", 
             RowBox[{"pFunc", ",", " ", 
              RowBox[{"Im", " ", "/@", " ", "Poles"}]}], "]"}], "]"}]}], "\n",
           "    ", "]"}]}], "\n", "  ", "]"}], ",", "\n", "  ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", 
         RowBox[{"Length", "[", "thimbleData", "]"}]}], "}"}]}], "\n", 
      "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Build", " ", "coordinate", " ", "pairs", " ", "explicitly"}], 
     " ", "\[LongDash]", " ", 
     RowBox[{"no", " ", "Transpose", " ", "needed"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"staircasePoints", " ", "=", " ", 
     RowBox[{"Table", "[", "\n", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"N", "[", 
          RowBox[{"-", 
           RowBox[{"S1Interp", "[", 
            RowBox[{"p0Values", "[", 
             RowBox[{"[", "k", "]"}], "]"}], "]"}]}], "]"}], ",", " ", 
         RowBox[{"nTrappedList", "[", 
          RowBox[{"[", "k", "]"}], "]"}]}], "}"}], ",", "\n", "  ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", 
         RowBox[{"Length", "[", "p0Values", "]"}]}], "}"}]}], "\n", "]"}]}], 
    ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Staircase", " ", "plot"}], " ", "*)"}], "\n", 
   RowBox[{"ListStepPlot", "[", 
    RowBox[{"staircasePoints", ",", "\n", "  ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", "  ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<Log[\[Kappa]]\>\"", ",", 
        " ", "\"\<Number of trapped poles\>\""}], "}"}]}], ",", "\n", "  ", 
     RowBox[{
     "PlotLabel", " ", "->", 
      " ", "\"\<Stokes staircase: trapped poles vs. Log \[Kappa]\>\""}], ",", 
     "\n", "  ", 
     RowBox[{"PlotStyle", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"Thick", ",", " ", "Blue"}], "}"}]}], ",", "\n", "  ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"All", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "0.5"}], ",", " ", 
          RowBox[{
           RowBox[{"Max", "[", "nTrappedList", "]"}], " ", "+", " ", "1"}]}], 
         "}"}]}], "}"}]}], ",", "\n", "  ", 
     RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", "\n", "  ", 
     RowBox[{"ImageSize", " ", "->", " ", "600"}], ",", "\n", "  ", 
     RowBox[{"Epilog", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"Red", ",", " ", 
        RowBox[{"PointSize", "[", "0.012", "]"}], ",", " ", 
        RowBox[{"Point", "[", "staircasePoints", "]"}]}], "}"}]}]}], "\n", 
    "]"}], "\n"}]}]], "Code",
