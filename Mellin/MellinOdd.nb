Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"S1Interp", "[", 
    RowBox[{"p_", "?", "NumericQ"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"df1approx", "[", "p", "]"}], " ", "-", 
    RowBox[{"PolyGamma", "[", 
     RowBox[{"0", ",", 
      RowBox[{"-", "p"}]}], "]"}], "+", 
    RowBox[{
     RowBox[{
      RowBox[{"Zeta", "'"}], "[", 
      RowBox[{"p", "+", 
       RowBox[{"15", "/", "2"}]}], "]"}], "/", 
     RowBox[{"Zeta", "[", 
      RowBox[{"p", "+", 
       RowBox[{"15", "/", "2"}]}], "]"}]}], "-", 
    RowBox[{
     RowBox[{
      RowBox[{"Zeta", "'"}], "[", 
      RowBox[{"p", "+", 
       RowBox[{"17", "/", "2"}]}], "]"}], "/", 
     RowBox[{"Zeta", "[", 
      RowBox[{"p", "+", 
       RowBox[{"17", "/", "2"}]}], "]"}]}], "-", 
    RowBox[{"2", "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", " ", "p"}], "+", "7"}], ")"}]}], "-", 
    RowBox[{"2", "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", " ", "p"}], "+", "17"}], ")"}]}], " ", "+", 
    RowBox[{"OddLog1", "[", "p", "]"}]}]}], ";"}]], "Code",
 CellChangeTimes->{{3.9894842673061733`*^9, 3.989484271751919*^9}, {
  3.9894843044670973`*^9, 3.989484315258389*^9}, {3.989484661740512*^9, 
