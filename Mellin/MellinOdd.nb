         RowBox[{"p", "+", 
          RowBox[{"17", "/", "2"}]}], "]"}]}], ")"}]}]}]}], ";", 
   RowBox[{
    RowBox[{"ALogDer", "[", 
     RowBox[{
      RowBox[{"p_", "?", "NumericQ"}], ",", 
      RowBox[{"xi_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{"xi", "+", 
     RowBox[{
      RowBox[{"DF", "[", 
       RowBox[{"p", ",", "1"}], "]"}], "/", 
      RowBox[{"DF", "[", 
       RowBox[{"p", ",", "0"}], "]"}]}], "-", 
     RowBox[{"PolyGamma", "[", 
      RowBox[{"0", ",", 
       RowBox[{"-", "p"}]}], "]"}], "+", 
     RowBox[{
      RowBox[{
       RowBox[{"Zeta", "'"}], "[", 
       RowBox[{"p", "+", 
        RowBox[{"15", "/", "2"}]}], "]"}], "/", 
      RowBox[{"Zeta", "[", 
       RowBox[{"p", "+", 
        RowBox[{"15", "/", "2"}]}], "]"}]}], "-", 
     RowBox[{"2", "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", " ", "p"}], "+", "7"}], ")"}]}], "-", 
     RowBox[{
      RowBox[{
       RowBox[{"Zeta", "'"}], "[", 
       RowBox[{"p", "+", 
        RowBox[{"17", "/", "2"}]}], "]"}], "/", 
      RowBox[{"Zeta", "[", 
       RowBox[{"p", "+", 
        RowBox[{"17", "/", "2"}]}], "]"}]}]}]}], ";", 
   RowBox[{
    RowBox[{"CalculateCentralDyadicDoubleResidue", "[", 
     RowBox[{"xi_", "?", "NumericQ"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"p", "=", 
         RowBox[{
          RowBox[{"-", "17"}], "/", "2"}]}], ",", "A0", ",", "A1"}], "}"}], ",", 
      RowBox[{
       RowBox[{"A0", "=", 
        RowBox[{"ADouble", "[", 
         RowBox[{"p", ",", "xi"}], "]"}]}], ";", 
       RowBox[{"A1", "=", 
        RowBox[{"A0", " ", 
         RowBox[{"ALogDer", "[", 
          RowBox[{"p", ",", "xi"}], "]"}]}]}], ";", 
       RowBox[{
        RowBox[{"A1", "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", 
           RowBox[{"Log", "[", "2", "]"}]}], ")"}]}], "+", 
        RowBox[{"A0", "/", "4"}]}]}]}], "]"}]}], ";"}], "\n"}]], "Input",
