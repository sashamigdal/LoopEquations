Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"nRiemann", "=", "200"}], ";", 
   RowBox[{"nDyadic", "=", "80"}], ";", 
   RowBox[{"RiemannPoles", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "8"}], "+", 
       RowBox[{"I", " ", 
        RowBox[{"Im", "[", 
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{"ZetaZero", "[", "n", "]"}], ",", "50"}], "]"}], "]"}]}]}],
       ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "nRiemann"}], "}"}]}], "]"}]}], ";", 
   RowBox[{"Poles", "=", "RiemannPoles"}], ";", 
   RowBox[{"zZeros", "=", 
    RowBox[{"Im", "/@", "RiemannPoles"}]}], ";", 
   RowBox[{"DyadicPoles", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", "17"}], "/", "2"}], "+", 
       RowBox[{"I", " ", "2", " ", "Pi", " ", 
        RowBox[{"k", "/", 
         RowBox[{"Log", "[", "2", "]"}]}]}]}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "1", ",", "nDyadic"}], "}"}]}], "]"}]}], ";", 
   RowBox[{"zDyadic", "=", 
    RowBox[{"Im", "/@", "DyadicPoles"}]}], ";", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Riemann poles = \>\"", ",", 
     RowBox[{"Length", "[", "RiemannPoles", "]"}], 
     ",", "\"\<  dyadic positive poles = \>\"", ",", 
     RowBox[{"Length", "[", "DyadicPoles", "]"}], 
     ",", "\"\<  first dyadic Im = \>\"", ",", 
     RowBox[{"N", "[", 
      RowBox[{"zDyadic", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "]"}], ";"}], "\n"}]], "Input",\

