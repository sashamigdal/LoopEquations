Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"BuildThimble", "[", "p0_", "]"}], " ", ":=", " ", "\n", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v0", ",", "eqs", ",", "path", ",", "xi", ",", 
       RowBox[{"eps", " ", "=", " ", "0.001"}], ",", 
       RowBox[{"tMax", "=", " ", "15"}]}], "}"}], ",", "\n", "     ", 
     RowBox[{
      RowBox[{"v0", " ", "=", " ", 
       RowBox[{"I", " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"2", "/", 
          RowBox[{"S2", "[", "p0", "]"}]}], "]"}]}]}], ";", "\n", 
      RowBox[{"xi", " ", "=", " ", 
       RowBox[{"-", 
        RowBox[{"S1", "[", "p0", "]"}]}]}], ";", "\n", 
      RowBox[{"eqs", " ", "=", " ", 
       RowBox[{"{", "\n", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"p", "'"}], "[", "t", "]"}], " ", "==", " ", 
          RowBox[{
           RowBox[{"-", "2"}], 
           RowBox[{"t", "/", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"S1Interp", "[", 
               RowBox[{"p", "[", "t", "]"}], "]"}], " ", "+", " ", "xi"}], 
             ")"}]}]}]}], ",", " ", "\n", 
         RowBox[{
          RowBox[{"p", "[", "eps", "]"}], " ", "==", " ", 
          RowBox[{"p0", " ", "+", " ", 
           RowBox[{"eps", "*", "v0"}]}]}]}], "\n", "}"}]}], ";", "\n", 
      RowBox[{"Quiet", "[", "\n", "        ", 
       RowBox[{
        RowBox[{"NDSolveValue", "[", 
         RowBox[{"eqs", ",", " ", "p", ",", " ", 
          RowBox[{"{", 
           RowBox[{"t", ",", " ", "eps", ",", " ", "tMax"}], "}"}], ",", "\n",
           "          ", 
          RowBox[{"WorkingPrecision", " ", "->", " ", "20"}], ",", " ", 
          RowBox[{"AccuracyGoal", " ", "->", " ", "10"}], ",", " ", 
          RowBox[{"PrecisionGoal", " ", "->", " ", "10"}], ",", "\n", 
          "          ", 
          RowBox[{"Method", " ", "->", " ", "\"\<StiffnessSwitching\>\""}], ",",
           " ", 
          RowBox[{"MaxSteps", " ", "->", " ", "300000"}]}], "]"}], ",", "\n", 
        "        ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"NDSolveValue", "::", "precw"}], ",", " ", 
          RowBox[{"NDSolveValue", "::", "ndsz"}]}], "}"}]}], "\n", "      ", 
       "]"}]}]}], "\n", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9894807111369267`*^9, 3.989480717649321*^9}, 
