  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "==="}], "="}], "*)"}],
   "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"SpectrumFromDNS", "[", 
      RowBox[{"N0_", ",", " ", "N1_"}], "]"}], ":=", 
     RowBox[{"Block", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "dnsInterp", ",", "kMin", ",", "kMax", ",", "OLambda", ",", 
         "filteredPoints", ",", "rawDNSData", ",", "sdatas"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"rawDNSData", "=", 
         RowBox[{"ToExpression", " ", "/@", 
          RowBox[{"Import", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"NotebookDirectory", "[", "]"}], 
             "<>", "\"\</July25_4Kdata/4096cube_ek.txt\>\""}], 
            ",", "\"\<Table\>\""}], "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"sdatas", "=", 
         RowBox[{"rawDNSData", "[", 
          RowBox[{"[", 
           RowBox[{"N0", ";;", "N1"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "1.", " ", "Create", " ", "a", " ", "smooth", " ", "interpolation", " ",
           "of", " ", "the", " ", "raw", " ", "DNS", " ", "Energy", " ", 
          "Spectrum"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{
          "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
            "===", "===", "===", "===", "===", "===", "===", "===", "==="}], 
          "="}], "*)"}], 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"OPTIMIZED", " ", "VECTORIZED"}], "&"}], " ", 
           "PARALLELIZED", " ", "PHASE"}], "-", 
          RowBox[{"LOCKED", " ", "H", 
           RowBox[{"(", "kappa", ")"}]}]}], "*)"}], 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{
          "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
            "===", "===", "===", "===", "===", "===", "===", "===", "==="}], 
          "="}], "*)"}], 
        RowBox[{"Quiet", "@", 
         RowBox[{"LaunchKernels", "[", "]"}]}], ";", "\n", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Use", " ", "MachinePrecision", " ", "floats", " ", 
           RowBox[{"(", "N", ")"}], " ", "for", " ", "blazing", " ", "fast", " ",
            "C"}], "-", 
          RowBox[{"level", " ", "vector", " ", "math"}]}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"numSnaps", "=", 
