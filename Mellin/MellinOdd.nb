           RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\n", 
        RowBox[{"(*", 
         RowBox[{"Safe", " ", "upper", " ", "limit"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"kMaxEval", "=", 
         RowBox[{"Floor", "[", "kMaxGrid", "]"}]}], ";", 
        "\[IndentingNewLine]", "\n", 
        RowBox[{"(*", 
         RowBox[{"Pre", "-", 
          RowBox[{
          "compute", " ", "static", " ", "numerical", " ", "arrays", " ", 
