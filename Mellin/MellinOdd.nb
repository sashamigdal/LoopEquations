Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"trapData", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"pFunc", "=", 
           RowBox[{"thimbleData", "[", 
            RowBox[{"[", "k", "]"}], "]"}]}], ",", "r", ",", "d"}], "}"}], ",", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Head", "[", "pFunc", "]"}], "=!=", 
           "InterpolatingFunction"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", 
            RowBox[{"-", "1"}], ",", 
            RowBox[{"-", "1"}], ",", 
            RowBox[{"{", "}"}], ",", 
            RowBox[{"{", "}"}]}], "}"}], ",", 
          RowBox[{
           RowBox[{"r", "=", 
            RowBox[{"CountTrappedPoles", "[", 
             RowBox[{"pFunc", ",", "zZeros", ",", 
              RowBox[{"-", "8.0`50"}]}], "]"}]}], ";", 
           RowBox[{"d", "=", 
            RowBox[{"CountTrappedPoles", "[", 
             RowBox[{"pFunc", ",", "zDyadic", ",", 
              RowBox[{
               RowBox[{"-", "17"}], "/", "2"}]}], "]"}]}], ";", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Length", "[", "r", "]"}], ",", 
             RowBox[{"Length", "[", "d", "]"}], ",", 
             RowBox[{
              RowBox[{"Length", "[", "r", "]"}], "+", 
              RowBox[{"Length", "[", "d", "]"}]}], ",", "r", ",", "d"}], 
            "}"}]}]}], "]"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", 
        RowBox[{"Length", "[", "thimbleData", "]"}]}], "}"}]}], "]"}]}], ";", 
   
   RowBox[{"nTrappedRiemannList", "=", 
    RowBox[{"trapData", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", 
   RowBox[{"nTrappedDyadicList", "=", 
    RowBox[{"trapData", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", 
   RowBox[{"nTrappedList", "=", 
    RowBox[{"trapData", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "3"}], "]"}], "]"}]}], ";", 
   RowBox[{"trappedRiemannIdxList", "=", 
    RowBox[{"trapData", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "4"}], "]"}], "]"}]}], ";", 
   RowBox[{"trappedDyadicIdxList", "=", 
    RowBox[{"trapData", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "5"}], "]"}], "]"}]}], ";", 
   RowBox[{"staircasePoints", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"N", "[", 
         RowBox[{"-", 
          RowBox[{"S1Interp", "[", 
           RowBox[{"p0Values", "[", 
            RowBox[{"[", "k", "]"}], "]"}], "]"}]}], "]"}], ",", 
        RowBox[{"nTrappedList", "[", 
         RowBox[{"[", "k", "]"}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", 
