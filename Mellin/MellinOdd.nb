   "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Fit", " ", "new", " ", 
    RowBox[{"rangedata", " ", "[", 
     RowBox[{
      RowBox[{"N0", "=", "150"}], ",", " ", 
      RowBox[{"N1", "=", "1000"}]}], "]"}], " ", "to", " ", "full", " ", 
    "Mellin", " ", "theory"}], "    ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], " ", 
   "*)"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Theory", " ", "interpolation"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"theoryInterp", " ", "=", " ", 
     RowBox[{"Interpolation", "[", 
      RowBox[{"theordata", ",", " ", 
       RowBox[{"InterpolationOrder", " ", "->", " ", "3"}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"xiMin", ",", " ", "xiMax"}], "}"}], " ", "=", " ", 
     RowBox[{
      RowBox[{"theoryInterp", "[", "\"\<Domain\>\"", "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"DNS", " ", 
     RowBox[{"tail", ":", " ", 
      RowBox[{
      "extract", " ", "numerical", " ", "values", " ", "from", " ", 
       "rangedata"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"rdX", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"#", "[", 
        RowBox[{"[", "1", "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
      "rangedata"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rdY", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"#", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "[", "\"\<Value\>\"", "]"}], " ", 
       "&"}], " ", "/@", " ", "rangedata"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rdE", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "[", "\"\<Error\>\"", "]"}], "^", 
        "2"}], " ", "&"}], " ", "/@", " ", "rangedata"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Simple", " ", "scan", " ", "for", " ", "best", " ", "shift", " ", "and", 
     " ", "scale"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"bestErr", " ", "=", " ", "Infinity"}], ";", " ", 
    RowBox[{"bestXS", " ", "=", " ", "0"}], ";", " ", 
    RowBox[{"bestA", " ", "=", " ", "1"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "overlap", ",", " ", "dX", ",", " ", "dY", ",", " ", "tY", ",", " ", 
          "sc", ",", " ", "err"}], "}"}], ",", "\n", "    ", 
        RowBox[{
         RowBox[{"overlap", " ", "=", " ", 
          RowBox[{"Select", "[", 
           RowBox[{
            RowBox[{"Transpose", "[", 
             RowBox[{"{", 
              RowBox[{"rdX", ",", " ", "rdY", ",", " ", "rdE"}], "}"}], "]"}],
             ",", " ", "\n", "      ", 
            RowBox[{
             RowBox[{"xiMin", " ", "<=", " ", 
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", "xs"}], " ", "<=",
               " ", "xiMax"}], " ", "&"}]}], "]"}]}], ";", "\n", "    ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "overlap", "]"}], " ", "<", " ", "10"}], ",",
            " ", 
           RowBox[{"Continue", "[", "]"}]}], "]"}], ";", "\n", "    ", 
         RowBox[{"dX", " ", "=", " ", 
          RowBox[{"overlap", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], ";", "\n", "    ", 
         RowBox[{"dY", " ", "=", " ", 
          RowBox[{"overlap", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}], ";", "\n", "    ", 
         RowBox[{"dE", " ", "=", " ", 
          RowBox[{"overlap", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "3"}], "]"}], "]"}]}], ";", "\n", "    ", 
         RowBox[{"tY", " ", "=", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"theoryInterp", "[", 
             RowBox[{"#", " ", "+", " ", "xs"}], "]"}], " ", "&"}], " ", "/@",
            " ", "dX"}]}], ";", "\n", "    ", 
         RowBox[{"sc", " ", "=", " ", 
          RowBox[{
           RowBox[{"Total", "[", 
            RowBox[{"dY", " ", "*", " ", 
             RowBox[{"tY", "/", "dE"}]}], "]"}], " ", "/", " ", 
           RowBox[{"Total", "[", 
            RowBox[{
             RowBox[{"tY", "^", "2"}], "/", "dE"}], "]"}]}]}], ";", "\n", 
         "    ", 
         RowBox[{"err", " ", "=", " ", 
          RowBox[{
           RowBox[{"Total", "[", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"dY", " ", "-", " ", 
               RowBox[{"sc", " ", "*", " ", "tY"}]}], ")"}], "^", "2"}], 
            "]"}], " ", "/", " ", 
           RowBox[{"Total", "[", 
            RowBox[{"dY", "^", "2"}], "]"}]}]}], ";", "\n", "    ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"err", " ", "<", " ", "bestErr"}], ",", " ", 
           RowBox[{
            RowBox[{"bestErr", " ", "=", " ", "err"}], ";", " ", 
            RowBox[{"bestXS", " ", "=", " ", "xs"}], ";", " ", 
            RowBox[{"bestA", " ", "=", " ", "sc"}]}]}], "]"}], ";"}]}], "\n", 
       "  ", "]"}], ",", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{"xs", ",", " ", "4.0", ",", " ", "6.0", ",", " ", "0.005"}], 
       "}"}]}], "\n", "]"}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<xiShift = \>\"", ",", " ", "bestXS"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<AScale = \>\"", ",", " ", "bestA"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Relative error = \>\"", ",", " ", "bestErr"}], "]"}], ";"}],
    "\n", "\n", 
