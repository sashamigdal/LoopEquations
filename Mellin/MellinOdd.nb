Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
   "Print", "[", "\"\<Computing H(xi) with Riemann + dyadic residues...\>\"", 
    "]"}], ";", 
   RowBox[{"results", "=", 
    RowBox[{"ParallelTable", "[", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "p0", ",", "pFunc", ",", "xi", ",", "rIdx", ",", "dIdx", ",", 
          "ghSum", ",", "S0", ",", "thimbleContrib", ",", "rSum", ",", "dSum",
           ",", "residueContrib"}], "}"}], ",", 
        RowBox[{
         RowBox[{"p0", "=", 
          RowBox[{"p0Values", "[", 
           RowBox[{"[", "k", "]"}], "]"}]}], ";", 
         RowBox[{"pFunc", "=", 
          RowBox[{"thimbleData", "[", 
           RowBox[{"[", "k", "]"}], "]"}]}], ";", 
         RowBox[{"xi", "=", 
          RowBox[{"-", 
           RowBox[{"S1", "[", "p0", "]"}]}]}], ";", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Head", "[", "pFunc", "]"}], "=!=", 
            "InterpolatingFunction"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"N", "[", "xi", "]"}], ",", "0.", ",", "0.", ",", "0.", ",",
              "0.", ",", "0."}], "}"}], ",", 
           RowBox[{
            RowBox[{"S0", "=", 
             RowBox[{
              RowBox[{"S", "[", "p0", "]"}], "+", 
              RowBox[{"xi", " ", "p0"}]}]}], ";", 
            RowBox[{"ghSum", "=", 
             RowBox[{"ThimbleGHSum", "[", 
              RowBox[{"p0", ",", "pFunc", ",", "xi"}], "]"}]}], ";", 
            RowBox[{"thimbleContrib", "=", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"1", "/", "Pi"}], ")"}], " ", 
              RowBox[{"Im", "[", 
               RowBox[{
                RowBox[{"Exp", "[", "S0", "]"}], " ", "ghSum"}], "]"}]}]}], ";", 
            RowBox[{"rIdx", "=", 
             RowBox[{"CountTrappedPoles", "[", 
              RowBox[{"pFunc", ",", "zZeros", ",", 
               RowBox[{"-", "8.0`50"}]}], "]"}]}], ";", 
            RowBox[{"dIdx", "=", 
             RowBox[{"CountTrappedPoles", "[", 
              RowBox[{"pFunc", ",", "zDyadic", ",", 
               RowBox[{
                RowBox[{"-", "17"}], "/", "2"}]}], "]"}]}], ";", 
            RowBox[{"rSum", "=", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Length", "[", "rIdx", "]"}], ">", "0"}], ",", 
               RowBox[{"Total", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"CalculateRiemannResidue", "[", 
                   RowBox[{
                    RowBox[{"RiemannPoles", "[", 
                    RowBox[{"[", "#", "]"}], "]"}], ",", "xi"}], "]"}], "&"}],
                  "/@", "rIdx"}], "]"}], ",", 
               RowBox[{"0", "+", 
                RowBox[{"0", " ", "I"}]}]}], "]"}]}], ";", 
            RowBox[{"dSum", "=", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Length", "[", "dIdx", "]"}], ">", "0"}], ",", 
               RowBox[{"Total", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"CalculateDyadicResidue", "[", 
                   RowBox[{
                    RowBox[{"DyadicPoles", "[", 
                    RowBox[{"[", "#", "]"}], "]"}], ",", "xi"}], "]"}], "&"}],
                  "/@", "dIdx"}], "]"}], ",", 
               RowBox[{"0", "+", 
                RowBox[{"0", " ", "I"}]}]}], "]"}]}], ";", 
            RowBox[{"residueContrib", "=", 
             RowBox[{"2", " ", 
              RowBox[{"Re", "[", 
               RowBox[{"rSum", "+", "dSum"}], "]"}]}]}], ";", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"N", "[", "xi", "]"}], ",", 
              RowBox[{"thimbleContrib", "+", "residueContrib"}], ",", 
              "residueContrib", ",", "thimbleContrib", ",", 
              RowBox[{"2", " ", 
               RowBox[{"Re", "[", "rSum", "]"}]}], ",", 
              RowBox[{"2", " ", 
               RowBox[{"Re", "[", "dSum", "]"}]}]}], "}"}]}]}], "]"}]}]}], 
       "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", 
        RowBox[{"Length", "[", "thimbleData", "]"}]}], "}"}]}], "]"}]}], ";", 
   
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Done. \>\"", ",", 
     RowBox[{"Length", "[", "results", "]"}], 
     ",", "\"\< points computed.\>\""}], "]"}], ";"}], "\n"}]], "Input",
 CellChangeTimes->{{3.9922878989772263`*^9, 3.992287898979784*^9}},
 CellLabel->
  "In[215]:=",ExpressionUUID->"581f717e-19cc-4b97-bd23-3736512c275d"],

