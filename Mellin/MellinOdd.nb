Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SInterp", "[", "p_", "]"}], ":=", 
   RowBox[{
    RowBox[{"df0approx", "[", "p", "]"}], "+", 
    RowBox[{"LogGamma", "[", 
     RowBox[{"-", "p"}], "]"}], "+", 
    RowBox[{"Log", "[", 
     RowBox[{"Zeta", "[", 
      RowBox[{"p", "+", 
       RowBox[{"15", "/", "2"}]}], "]"}], "]"}], "-", " ", 
    RowBox[{"Log", "[", 
     RowBox[{"Zeta", "[", 
      RowBox[{"p", "+", 
       RowBox[{"17", "/", "2"}]}], "]"}], "]"}], "-", 
    RowBox[{"Log", "[", 
     RowBox[{
      RowBox[{"2", " ", "p"}], "+", "7"}], "]"}], "-", 
    RowBox[{"Log", "[", 
     RowBox[{
      RowBox[{"2", " ", "p"}], "+", "17"}], "]"}], " ", "+", " ", 
    RowBox[{"OddLog", "[", "p", "]"}]}]}], ";"}]], "Code",
 CellChangeTimes->{{3.9894894416568937`*^9, 3.9894894841324043`*^9}, {
  3.9922856424261513`*^9, 3.9922856475374527`*^9}},
