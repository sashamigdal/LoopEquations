Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"CountTrappedPoles", "[", 
    RowBox[{"pFunc_", ",", " ", "zZeros_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"vals", ",", " ", "reVals", ",", " ", "imVals", ",", " ", 
       RowBox[{"trapped", " ", "=", " ", 
        RowBox[{"{", "}"}]}], ",", " ", "crossings", ",", " ", "tn"}], "}"}], 
     ",", "\n", "  ", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Head", "[", "pFunc", "]"}], " ", "=!=", " ", 
         "InterpolatingFunction"}], ",", " ", 
        RowBox[{"Return", "[", 
         RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\n", "  ", 
      RowBox[{"vals", " ", "=", " ", 
       RowBox[{"pFunc", "[", "\"\<ValuesOnGrid\>\"", "]"}]}], ";", "\n", "  ", 
      RowBox[{"reVals", " ", "=", " ", 
       RowBox[{"Re", "[", "vals", "]"}]}], ";", " ", "\n", "  ", 
      RowBox[{"imVals", " ", "=", " ", 
       RowBox[{"Im", "[", "vals", "]"}]}], ";", "\n", "  ", 
      RowBox[{"Do", "[", "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"tn", " ", "=", " ", 
          RowBox[{"zZeros", "[", 
           RowBox[{"[", "n", "]"}], "]"}]}], ";", "\n", "    ", 
         RowBox[{"crossings", " ", "=", " ", "0"}], ";", "\n", "    ", 
         RowBox[{"Do", "[", "\n", "      ", 
          RowBox[{
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"imVals", "[", 
                   RowBox[{"[", "k", "]"}], "]"}], " ", "<=", " ", "tn"}], 
                 " ", "&&", " ", 
                 RowBox[{
                  RowBox[{"imVals", "[", 
                   RowBox[{"[", 
                    RowBox[{"k", "+", "1"}], "]"}], "]"}], " ", ">", " ", 
                  "tn"}]}], ")"}], " ", "||", " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"imVals", "[", 
                   RowBox[{"[", "k", "]"}], "]"}], " ", ">=", " ", "tn"}], 
                 " ", "&&", " ", 
                 RowBox[{
                  RowBox[{"imVals", "[", 
                   RowBox[{"[", 
                    RowBox[{"k", "+", "1"}], "]"}], "]"}], " ", "<", " ", 
                  "tn"}]}], ")"}]}], ",", "\n", "        ", 
              RowBox[{"Module", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"w1", ",", " ", "w2", ",", " ", "reCross"}], "}"}], ",",
                 "\n", "          ", 
                RowBox[{
                 RowBox[{"w1", " ", "=", " ", 
                  RowBox[{"Abs", "[", 
                   RowBox[{
                    RowBox[{"imVals", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", "+", "1"}], "]"}], "]"}], " ", "-", " ", 
                    "tn"}], "]"}]}], ";", " ", 
                 RowBox[{"w2", " ", "=", " ", 
                  RowBox[{"Abs", "[", 
                   RowBox[{
                    RowBox[{"imVals", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], " ", "-", " ", "tn"}], 
                   "]"}]}], ";", "\n", "          ", 
                 RowBox[{"reCross", " ", "=", " ", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"w1", " ", "*", " ", 
                    RowBox[{"reVals", "[", 
                    RowBox[{"[", "k", "]"}], "]"}]}], " ", "+", " ", 
                    RowBox[{"w2", " ", "*", " ", 
                    RowBox[{"reVals", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", "+", "1"}], "]"}], "]"}]}]}], ")"}], " ", "/",
                    " ", 
                   RowBox[{"(", 
                    RowBox[{"w1", " ", "+", " ", "w2"}], ")"}]}]}], ";", "\n",
                  "          ", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{"reCross", " ", "<", " ", 
                    RowBox[{"-", "8.0`50"}]}], ",", " ", 
                   RowBox[{"crossings", "++"}]}], "]"}], ";"}]}], "\n", 
               "        ", "]"}]}], "\n", "      ", "]"}], ";"}], "\n", 
           "    ", ",", " ", 
           RowBox[{"{", 
            RowBox[{"k", ",", " ", "1", ",", " ", 
             RowBox[{
              RowBox[{"Length", "[", "vals", "]"}], " ", "-", " ", "1"}]}], 
            "}"}]}], "]"}], ";", "\n", "    ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"OddQ", "[", "crossings", "]"}], ",", " ", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"trapped", ",", " ", "n"}], "]"}]}], "]"}], ";"}], "\n", 
        "  ", ",", " ", 
        RowBox[{"{", 
         RowBox[{"n", ",", " ", "1", ",", " ", 
          RowBox[{"Length", "[", "zZeros", "]"}]}], "}"}]}], "]"}], ";", "\n",
       "  ", "trapped"}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Poles", " ", "=", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "8"}], " ", "+", " ", 
       RowBox[{"I", " ", 
        RowBox[{"Im", "[", 
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{"ZetaZero", "[", "n", "]"}], ",", "50"}], "]"}], "]"}]}]}],
       ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "200"}], "}"}]}], "]"}]}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Imaginary", " ", "parts", " ", "of", " ", "poles", "\n", "\[Placeholder]",
