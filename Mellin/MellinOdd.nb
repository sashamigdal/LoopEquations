Cell[BoxData[
 RowBox[{
  RowBox[{"MellinFromDNS", "[", 
   RowBox[{"xLim_", ",", "N0_", ",", "N1_"}], "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "Sdata", ",", "sdatas", ",", "T", ",", "L", ",", "kdata", ",", "data3", ",",
       "deriv", ",", "MellinData", ",", "dx", ",", 
      RowBox[{"M", "=", "200"}], ",", "P1", ",", "P2", ",", "Ns"}], "}"}], ",", 
    RowBox[{
     RowBox[{"dx", "=", 
      RowBox[{"2.0", " ", 
       RowBox[{"xLim", "/", "M"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Sdata", "=", 
      RowBox[{"ToExpression", "/@", 
       RowBox[{"Import", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"NotebookDirectory", "[", "]"}], 
          "<>", "\"\</July25_4Kdata/4096cube_ek.txt\>\""}], 
         ",", "\"\<Table\>\""}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"T", "=", 
      RowBox[{"Length", "[", "Sdata", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"L", "=", 
      RowBox[{"Length", "[", 
       RowBox[{"Sdata", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<{T,L}=\>\"", ",", 
       RowBox[{"{", 
        RowBox[{"T", ",", "L"}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"sdatas", "=", 
      RowBox[{"Sdata", "[", 
       RowBox[{"[", 
        RowBox[{"N0", ";;", "N1"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Ns", "=", 
      RowBox[{"Length", "[", "sdatas", "]"}]}], ";", 
     RowBox[{"(*", 
      RowBox[{"Number", " ", "of", " ", "snapshots"}], "*)"}], 
     RowBox[{"(*", 
      RowBox[{
      "Force", " ", "numerical", " ", "for", " ", "vastly", " ", "faster", " ",
        "complex", " ", "powers"}], "*)"}], 
     RowBox[{"kdata", "=", 
      RowBox[{"N", "[", 
       RowBox[{"Range", "[", "L", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"(*", 
      RowBox[{"Denominator", " ", "M", 
       RowBox[{"(", "0", ")"}], " ", "for", " ", "each", " ", 
       RowBox[{"snapshot", ":", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{"k", "^", "2"}], " ", "E", 
          RowBox[{"(", "k", ")"}]}], "]"}]}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"data3", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"sdatas", "[", 
           RowBox[{"[", "#", "]"}], "]"}], ".", 
          RowBox[{
           RowBox[{"(", "kdata", ")"}], "^", "2"}]}], ")"}], "&"}], "/@", 
       RowBox[{"Range", "[", "Ns", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Average", " ", "logarithmic", " ", "derivative", " ", "across", " ", 
       "snapshots", " ", "for", " ", "phase", " ", "shift"}], "*)"}], 
     RowBox[{"deriv", "=", 
      RowBox[{"Mean", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"sdatas", "[", 
              RowBox[{"[", "#", "]"}], "]"}], ".", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"kdata", "^", "2"}], " ", 
               RowBox[{"Log", "[", "kdata", "]"}]}], ")"}]}], ")"}], "&"}], "/@", 
          RowBox[{"Range", "[", "Ns", "]"}]}], ")"}], "/", "data3"}], "]"}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"MellinData", "=", 
      RowBox[{"ParallelTable", "[", 
       RowBox[{
        RowBox[{"Block", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "data", ",", "rat", ",", "shiftedRat", ",", "meanR", ",", "errR", ",",
             "meanI", ",", "errI"}], "}"}], ",", 
          RowBox[{"(*", 
           RowBox[{
           "Complex", " ", "Mellin", " ", "for", " ", "each", " ", 
            "snapshot"}], "*)"}], 
          RowBox[{
           RowBox[{"data", "=", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"sdatas", "[", 
                 RowBox[{"[", "#", "]"}], "]"}], ".", 
                RowBox[{
                 RowBox[{"(", "kdata", ")"}], "^", 
                 RowBox[{"(", 
                  RowBox[{"2", "-", 
                   RowBox[{"I", " ", "x"}]}], ")"}]}]}], ")"}], "&"}], "/@", 
             RowBox[{"Range", "[", "Ns", "]"}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"rat", "=", 
            RowBox[{"data", "/", "data3"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{"CRITICAL", " ", 
             RowBox[{"FIX", ":", 
              RowBox[{
              "Apply", " ", "phase", " ", "shift", " ", "to", " ", "the", " ",
                "FULL", " ", "complex", " ", "array", " ", "FIRST"}]}]}], 
            "*)"}], 
           RowBox[{"shiftedRat", "=", 
            RowBox[{"rat", "*", 
             RowBox[{"Exp", "[", 
              RowBox[{"I", "*", "x", "*", "deriv"}], "]"}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
            "Compute", " ", "Mean", " ", "and", " ", "Standard", " ", "Error",
              " ", "of", " ", "the", " ", "Mean", " ", 
             RowBox[{"(", "SEM", ")"}]}], "*)"}], 
           RowBox[{"meanR", "=", 
            RowBox[{"Mean", "[", 
             RowBox[{"Re", "[", "shiftedRat", "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"errR", "=", 
            RowBox[{
             RowBox[{"StandardDeviation", "[", 
              RowBox[{"Re", "[", "shiftedRat", "]"}], "]"}], "/", 
             RowBox[{"Sqrt", "[", 
              RowBox[{"Length", "[", 
               RowBox[{"Re", "[", "shiftedRat", "]"}], "]"}], "]"}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"meanI", "=", 
            RowBox[{"Mean", "[", 
             RowBox[{"Im", "[", "shiftedRat", "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"errI", "=", 
            RowBox[{
             RowBox[{"StandardDeviation", "[", 
              RowBox[{"Im", "[", "shiftedRat", "]"}], "]"}], "/", 
             RowBox[{"Sqrt", "[", 
              RowBox[{"Length", "[", 
               RowBox[{"Im", "[", "shiftedRat", "]"}], "]"}], "]"}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
            "Create", " ", "proper", " ", "Around", " ", "objects", " ", 
             "with", " ", "a", " ", 
             RowBox[{"comma", "!"}]}], "*)"}], 
           RowBox[{"{", 
            RowBox[{"x", ",", 
             RowBox[{"Around", "[", 
              RowBox[{"meanR", ",", "errR"}], "]"}], ",", 
             RowBox[{"Around", "[", 
