        "\[IndentingNewLine]", 
        RowBox[{"PrintTemporary", "[", 
         RowBox[{"\"\<Processing \>\"", ",", "numSnaps", 
          ",", "\"\< snapshots on \>\"", ",", "$KernelCount", 
