Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Detect", " ", "incomplete", " ", 
     RowBox[{"thimble", ":", " ", 
      RowBox[{"solver", " ", "stopped", " ", "early"}]}]}], ",", " ", 
    RowBox[{
     RowBox[{"path", " ", 
      RowBox[{"didn", "'"}], "t", " ", "reach", " ", 
      RowBox[{"Re", "[", "p", "]"}]}], " ", "=", " ", 
     RowBox[{"-", "8"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"IsIncomplete", "[", "pFunc_", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"tEnd", ",", " ", "endVal"}], "}"}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Head", "[", "pFunc", "]"}], " ", "=!=", " ", 
           "InterpolatingFunction"}], ",", " ", 
          RowBox[{"Return", "[", "False", "]"}]}], "]"}], ";", "\n", "  ", 
        RowBox[{"tEnd", " ", "=", " ", 
         RowBox[{
          RowBox[{"pFunc", "[", "\"\<Domain\>\"", "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", " ", "2"}], "]"}], "]"}]}], ";", "\n", "  ", 
        RowBox[{"endVal", " ", "=", " ", 
         RowBox[{"pFunc", "[", "tEnd", "]"}]}], ";", "\n", "  ", 
        RowBox[{
         RowBox[{"tEnd", " ", "<", " ", "14.9"}], " ", "&&", " ", 
         RowBox[{
          RowBox[{"Re", "[", "endVal", "]"}], " ", ">", " ", 
          RowBox[{"-", "8.0"}]}]}]}]}], "\n", "]"}]}], ";"}], 
   "\n"}]}]], "Code",
