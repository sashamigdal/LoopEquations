                   "over", " ", "lists", " ", "in", " ", "modern", " ", 
                  RowBox[{"Mathematica", "!"}]}], "*)"}], 
                "\[IndentingNewLine]", 
                RowBox[{"FEv", "=", 
                 RowBox[{"Einterp", "[", "kSumRange", "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"(*", 
                 RowBox[{
                  RowBox[{"2", ")"}], " ", "VECTORIZED", " ", "MOMENTS", " ", 
