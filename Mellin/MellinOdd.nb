              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "8"}], ",", " ", "ymin"}], "}"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "8"}], ",", " ", "ymax"}], "}"}]}], "}"}], 
             "]"}]}], "}"}], ",", "\n", "    ", 
          RowBox[{"{", 
           RowBox[{"Dashed", ",", " ", 
            RowBox[{"Darker", "[", "Green", "]"}], ",", " ", 
            RowBox[{"Thickness", "[", "0.001", "]"}], ",", " ", 
            RowBox[{"Line", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "7"}], ",", " ", "ymin"}], "}"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "7"}], ",", " ", "ymax"}], "}"}]}], "}"}], 
             "]"}]}], "}"}]}], "\n", "  ", "}"}], "]"}], ",", "\n", "  ", 
       "\n", "  ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", "  ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
