       "  ", 
       RowBox[{"AspectRatio", " ", "->", " ", "1"}], ",", "\n", "  ", 
       RowBox[{"ImageSize", " ", "->", " ", "800"}], ",", "\n", "  ", 
       RowBox[{"Background", " ", "->", " ", "White"}], ",", "\n", "  ", 
       RowBox[{"PlotLabel", " ", "->", " ", 
        RowBox[{"Style", "[", 
