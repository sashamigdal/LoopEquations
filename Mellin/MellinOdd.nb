          RowBox[{"Range", "[", 
           RowBox[{"2", ",", "kMaxEval"}], "]"}], "]"}]}], ";", "\n", "\t", 
        RowBox[{"logKSumRange", "=", 
         RowBox[{"Log", "[", "kSumRange", "]"}]}], ";", "\n", "\t", 
        RowBox[{"kSumRangeSq", "=", 
