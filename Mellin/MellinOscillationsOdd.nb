            RowBox[{"[", "k", "]"}], "]"}]}], ";", "\n", "    ", 
          RowBox[{"pFunc", " ", "=", " ", 
           RowBox[{"thimbleData", "[", 
            RowBox[{"[", "k", "]"}], "]"}]}], ";", "\n", "    ", 
          RowBox[{"fullPts", " ", "=", " ", 
