          RowBox[{"PointSize", "[", "0.003", "]"}], ",", " ", 
          RowBox[{"Point", " ", "/@", " ", "visZeros"}], ",", "\n", "    ", 
          RowBox[{"(*", " ", 
           RowBox[{"Saddle", " ", 
            RowBox[{"points", ":", " ", 
             RowBox[{
             "colored", " ", "dots", " ", "on", " ", "real", " ", 
              "axis"}]}]}], " ", "*)"}], "\n", "    ", 
          RowBox[{"Table", "[", "\n", "      ", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"thimbleColors", "[", 
               RowBox[{"[", "i", "]"}], "]"}], ",", " ", 
              RowBox[{"PointSize", "[", "0.010", "]"}], ",", " ", "\n", 
              "       ", 
              RowBox[{"Point", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"N", "[", 
                  RowBox[{"Re", "[", 
