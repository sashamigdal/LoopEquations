Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "CalculateRiemannResidue", ",", "CalculateDyadicResidue", ",", "ADouble", 
     ",", "ALogDer", ",", "CalculateCentralDyadicDoubleResidue"}], "]"}], ";", 
   RowBox[{
    RowBox[{"CalculateRiemannResidue", "[", 
     RowBox[{"pVal_", ",", "xi_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"p", "=", "pVal"}], "}"}], ",", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{"xi", " ", "p"}], "]"}], " ", 
       RowBox[{"DF", "[", 
        RowBox[{"p", ",", "0"}], "]"}], " ", 
       RowBox[{"Gamma", "[", 
        RowBox[{"-", "p"}], "]"}], " ", 
       RowBox[{
        RowBox[{"Zeta", "[", 
         RowBox[{"p", "+", 
          RowBox[{"15", "/", "2"}]}], "]"}], "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", " ", "p"}], "+", "7"}], ")"}], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", " ", "p"}], "+", "17"}], ")"}], " ", 
          RowBox[{
           RowBox[{"Zeta", "'"}], "[", 
           RowBox[{"p", "+", 
            RowBox[{"17", "/", "2"}]}], "]"}], 
          RowBox[{"(", 
           RowBox[{"1", "-", 
            RowBox[{"2", "^", 
             RowBox[{"(", 
              RowBox[{"-", 
               RowBox[{"(", 
                RowBox[{"p", "+", 
                 RowBox[{"17", "/", "2"}]}], ")"}]}], ")"}]}]}], ")"}]}], 
         ")"}]}]}]}], "]"}]}], ";", 
   RowBox[{
    RowBox[{"CalculateDyadicResidue", "[", 
     RowBox[{"pVal_", ",", "xi_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"p", "=", "pVal"}], "}"}], ",", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{"xi", " ", "p"}], "]"}], " ", 
       RowBox[{"DF", "[", 
        RowBox[{"p", ",", "0"}], "]"}], " ", 
       RowBox[{"Gamma", "[", 
        RowBox[{"-", "p"}], "]"}], " ", 
       RowBox[{
        RowBox[{"Zeta", "[", 
         RowBox[{"p", "+", 
          RowBox[{"15", "/", "2"}]}], "]"}], "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", " ", "p"}], "+", "7"}], ")"}], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", " ", "p"}], "+", "17"}], ")"}], " ", 
          RowBox[{"Zeta", "[", 
           RowBox[{"p", "+", 
            RowBox[{"17", "/", "2"}]}], "]"}], " ", 
          RowBox[{"Log", "[", "2", "]"}]}], ")"}]}]}]}], "]"}]}], ";", 
   RowBox[{
    RowBox[{"ADouble", "[", 
     RowBox[{
      RowBox[{"p_", "?", "NumericQ"}], ",", 
      RowBox[{"xi_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{"xi", " ", "p"}], "]"}], " ", 
     RowBox[{"DF", "[", 
      RowBox[{"p", ",", "0"}], "]"}], " ", 
     RowBox[{"Gamma", "[", 
      RowBox[{"-", "p"}], "]"}], " ", 
     RowBox[{
      RowBox[{"Zeta", "[", 
       RowBox[{"p", "+", 
        RowBox[{"15", "/", "2"}]}], "]"}], "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", " ", "p"}], "+", "7"}], ")"}], " ", 
        RowBox[{"Zeta", "[", 
         RowBox[{"p", "+", 
          RowBox[{"17", "/", "2"}]}], "]"}]}], ")"}]}]}]}], ";", 
   RowBox[{
    RowBox[{"ALogDer", "[", 
     RowBox[{
      RowBox[{"p_", "?", "NumericQ"}], ",", 
      RowBox[{"xi_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{"xi", "+", 
     RowBox[{
      RowBox[{"DF", "[", 
       RowBox[{"p", ",", "1"}], "]"}], "/", 
      RowBox[{"DF", "[", 
       RowBox[{"p", ",", "0"}], "]"}]}], "-", 
     RowBox[{"PolyGamma", "[", 
      RowBox[{"0", ",", 
       RowBox[{"-", "p"}]}], "]"}], "+", 
     RowBox[{
      RowBox[{
       RowBox[{"Zeta", "'"}], "[", 
       RowBox[{"p", "+", 
        RowBox[{"15", "/", "2"}]}], "]"}], "/", 
      RowBox[{"Zeta", "[", 
       RowBox[{"p", "+", 
        RowBox[{"15", "/", "2"}]}], "]"}]}], "-", 
     RowBox[{"2", "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", " ", "p"}], "+", "7"}], ")"}]}], "-", 
     RowBox[{
      RowBox[{
       RowBox[{"Zeta", "'"}], "[", 
       RowBox[{"p", "+", 
        RowBox[{"17", "/", "2"}]}], "]"}], "/", 
      RowBox[{"Zeta", "[", 
       RowBox[{"p", "+", 
        RowBox[{"17", "/", "2"}]}], "]"}]}]}]}], ";", 
   RowBox[{
    RowBox[{"CalculateCentralDyadicDoubleResidue", "[", 
     RowBox[{"xi_", "?", "NumericQ"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"p", "=", 
         RowBox[{
          RowBox[{"-", "17"}], "/", "2"}]}], ",", "A0", ",", "A1"}], "}"}], ",", 
      RowBox[{
       RowBox[{"A0", "=", 
        RowBox[{"ADouble", "[", 
         RowBox[{"p", ",", "xi"}], "]"}]}], ";", 
       RowBox[{"A1", "=", 
        RowBox[{"A0", " ", 
         RowBox[{"ALogDer", "[", 
          RowBox[{"p", ",", "xi"}], "]"}]}]}], ";", 
       RowBox[{
        RowBox[{"A1", "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", 
           RowBox[{"Log", "[", "2", "]"}]}], ")"}]}], "+", 
        RowBox[{"A0", "/", "4"}]}]}]}], "]"}]}], ";"}], "\n"}]], "Input",
