       RowBox[{
        RowBox[{"f0", "=", 
         RowBox[{"DF", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "1"}], "-", "q"}], ",", "0"}], "]"}]}], ";", 
        RowBox[{"f1", "=", 
