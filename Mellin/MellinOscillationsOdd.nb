Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"CountTrappedPoles", "[", 
    RowBox[{"pFunc_", ",", " ", "zZeros_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"vals", ",", " ", "reVals", ",", " ", "imVals", ",", " ", 
       RowBox[{"trapped", " ", "=", " ", 
        RowBox[{"{", "}"}]}], ",", " ", "crossings", ",", " ", "tn"}], "}"}], 
     ",", "\n", "  ", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Head", "[", "pFunc", "]"}], " ", "=!=", " ", 
         "InterpolatingFunction"}], ",", " ", 
        RowBox[{"Return", "[", 
         RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\n", "  ", 
      RowBox[{"vals", " ", "=", " ", 
       RowBox[{"pFunc", "[", "\"\<ValuesOnGrid\>\"", "]"}]}], ";", "\n", "  ", 
      RowBox[{"reVals", " ", "=", " ", 
       RowBox[{"Re", "[", "vals", "]"}]}], ";", " ", "\n", "  ", 
      RowBox[{"imVals", " ", "=", " ", 
       RowBox[{"Im", "[", "vals", "]"}]}], ";", "\n", "  ", 
      RowBox[{"Do", "[", "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"tn", " ", "=", " ", 
          RowBox[{"zZeros", "[", 
           RowBox[{"[", "n", "]"}], "]"}]}], ";", "\n", "    ", 
         RowBox[{"crossings", " ", "=", " ", "0"}], ";", "\n", "    ", 
         RowBox[{"Do", "[", "\n", "      ", 
          RowBox[{
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"imVals", "[", 
                   RowBox[{"[", "k", "]"}], "]"}], " ", "<=", " ", "tn"}], 
                 " ", "&&", " ", 
                 RowBox[{
                  RowBox[{"imVals", "[", 
                   RowBox[{"[", 
                    RowBox[{"k", "+", "1"}], "]"}], "]"}], " ", ">", " ", 
                  "tn"}]}], ")"}], " ", "||", " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"imVals", "[", 
                   RowBox[{"[", "k", "]"}], "]"}], " ", ">=", " ", "tn"}], 
                 " ", "&&", " ", 
                 RowBox[{
                  RowBox[{"imVals", "[", 
                   RowBox[{"[", 
                    RowBox[{"k", "+", "1"}], "]"}], "]"}], " ", "<", " ", 
                  "tn"}]}], ")"}]}], ",", "\n", "        ", 
              RowBox[{"Module", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"w1", ",", " ", "w2", ",", " ", "reCross"}], "}"}], ",",
                 "\n", "          ", 
                RowBox[{
                 RowBox[{"w1", " ", "=", " ", 
                  RowBox[{"Abs", "[", 
                   RowBox[{
                    RowBox[{"imVals", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", "+", "1"}], "]"}], "]"}], " ", "-", " ", 
                    "tn"}], "]"}]}], ";", " ", 
                 RowBox[{"w2", " ", "=", " ", 
                  RowBox[{"Abs", "[", 
                   RowBox[{
                    RowBox[{"imVals", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], " ", "-", " ", "tn"}], 
                   "]"}]}], ";", "\n", "          ", 
                 RowBox[{"reCross", " ", "=", " ", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"w1", " ", "*", " ", 
                    RowBox[{"reVals", "[", 
                    RowBox[{"[", "k", "]"}], "]"}]}], " ", "+", " ", 
                    RowBox[{"w2", " ", "*", " ", 
                    RowBox[{"reVals", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", "+", "1"}], "]"}], "]"}]}]}], ")"}], " ", "/",
                    " ", 
                   RowBox[{"(", 
                    RowBox[{"w1", " ", "+", " ", "w2"}], ")"}]}]}], ";", "\n",
                  "          ", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{"reCross", " ", "<", " ", 
                    RowBox[{"-", "8.0`50"}]}], ",", " ", 
                   RowBox[{"crossings", "++"}]}], "]"}], ";"}]}], "\n", 
               "        ", "]"}]}], "\n", "      ", "]"}], ";"}], "\n", 
           "    ", ",", " ", 
           RowBox[{"{", 
            RowBox[{"k", ",", " ", "1", ",", " ", 
             RowBox[{
              RowBox[{"Length", "[", "vals", "]"}], " ", "-", " ", "1"}]}], 
            "}"}]}], "]"}], ";", "\n", "    ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"OddQ", "[", "crossings", "]"}], ",", " ", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"trapped", ",", " ", "n"}], "]"}]}], "]"}], ";"}], "\n", 
        "  ", ",", " ", 
        RowBox[{"{", 
         RowBox[{"n", ",", " ", "1", ",", " ", 
          RowBox[{"Length", "[", "zZeros", "]"}]}], "}"}]}], "]"}], ";", "\n",
       "  ", "trapped"}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Poles", " ", "=", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"9", " ", "+", " ", 
       RowBox[{"I", " ", 
        RowBox[{"Im", "[", 
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{"ZetaZero", "[", "n", "]"}], ",", "50"}], "]"}], "]"}]}]}],
       ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "200"}], "}"}]}], "]"}]}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Imaginary", " ", "parts", " ", "of", " ", "poles", "\n", "\[Placeholder]",
     "\n", "\n", " ", "for", " ", "crossing", " ", "detection"}], " ", 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"zZeros", " ", "=", " ", 
   RowBox[{"Im", " ", "/@", " ", "Poles"}]}], ";"}]}], "Code",
 CellChangeTimes->{3.999613322280952*^9},
 CellLabel->
  "In[103]:=",ExpressionUUID->"2227e94c-7b3f-4ee9-9485-9a3a940ce8a9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Detect", " ", "incomplete", " ", 
     RowBox[{"thimble", ":", " ", 
      RowBox[{"solver", " ", "stopped", " ", "early"}]}]}], ",", " ", 
    RowBox[{
     RowBox[{"path", " ", 
      RowBox[{"didn", "'"}], "t", " ", "reach", " ", 
      RowBox[{"Re", "[", "p", "]"}]}], " ", "=", " ", 
     RowBox[{"-", "8"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"IsIncomplete", "[", "pFunc_", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"tEnd", ",", " ", "endVal"}], "}"}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Head", "[", "pFunc", "]"}], " ", "=!=", " ", 
           "InterpolatingFunction"}], ",", " ", 
          RowBox[{"Return", "[", "False", "]"}]}], "]"}], ";", "\n", "  ", 
        RowBox[{"tEnd", " ", "=", " ", 
         RowBox[{
          RowBox[{"pFunc", "[", "\"\<Domain\>\"", "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", " ", "2"}], "]"}], "]"}]}], ";", "\n", "  ", 
        RowBox[{"endVal", " ", "=", " ", 
         RowBox[{"pFunc", "[", "tEnd", "]"}]}], ";", "\n", "  ", 
        RowBox[{
         RowBox[{"tEnd", " ", "<", " ", "14.9"}], " ", "&&", " ", 
         RowBox[{
          RowBox[{"Re", "[", "endVal", "]"}], " ", ">", " ", 
          RowBox[{"-", "8.0"}]}]}]}]}], "\n", "]"}]}], ";"}], 
   "\n"}]}]], "Code",
 CellLabel->
  "In[106]:=",ExpressionUUID->"b383fdac-fe7e-44c4-a435-992f59d262e4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Safety", " ", "check"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", "p0Values", "]"}], " ", "!=", " ", 
       RowBox[{"Length", "[", "thimbleData", "]"}]}], ",", "\n", "  ", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Mismatch: \>\"", ",", " ", 
         RowBox[{"Length", "[", "p0Values", "]"}], ",", 
         " ", "\"\< p0 values vs \>\"", ",", " ", "\n", "    ", 
         RowBox[{"Length", "[", "thimbleData", "]"}], ",", 
         " ", "\"\< thimbles. Adjusting...\>\""}], "]"}], ";", "\n", "  ", 
       RowBox[{"p0Values", " ", "=", " ", 
        RowBox[{"p0Values", "[", 
         RowBox[{"[", 
          RowBox[{";;", " ", 
           RowBox[{"Length", "[", "thimbleData", "]"}]}], "]"}], "]"}]}], 
       ";"}]}], "\n", "]"}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Count", " ", "trapped", " ", "poles"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"nTrappedList", " ", "=", " ", 
     RowBox[{"Table", "[", "\n", "  ", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"pFunc", " ", "=", " ", 
           RowBox[{"thimbleData", "[", 
            RowBox[{"[", "k", "]"}], "]"}]}], "}"}], ",", "\n", "    ", 
         RowBox[{"Which", "[", "\n", "      ", 
          RowBox[{
           RowBox[{
            RowBox[{"Head", "[", "pFunc", "]"}], " ", "=!=", " ", 
            "InterpolatingFunction"}], ",", " ", 
           RowBox[{"-", "1"}], ",", "\n", "      ", "True", ",", " ", 
           RowBox[{"Length", "[", 
            RowBox[{"CountTrappedPoles", "[", 
             RowBox[{"pFunc", ",", " ", 
              RowBox[{"Im", " ", "/@", " ", "Poles"}]}], "]"}], "]"}]}], "\n",
           "    ", "]"}]}], "\n", "  ", "]"}], ",", "\n", "  ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", 
         RowBox[{"Length", "[", "thimbleData", "]"}]}], "}"}]}], "\n", 
      "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Build", " ", "coordinate", " ", "pairs", " ", "explicitly"}], 
     " ", "\[LongDash]", " ", 
     RowBox[{"no", " ", "Transpose", " ", "needed"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"staircasePoints", " ", "=", " ", 
     RowBox[{"Table", "[", "\n", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"N", "[", 
          RowBox[{"-", 
           RowBox[{"S1Interp", "[", 
            RowBox[{"p0Values", "[", 
             RowBox[{"[", "k", "]"}], "]"}], "]"}]}], "]"}], ",", " ", 
         RowBox[{"nTrappedList", "[", 
          RowBox[{"[", "k", "]"}], "]"}]}], "}"}], ",", "\n", "  ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", 
         RowBox[{"Length", "[", "p0Values", "]"}]}], "}"}]}], "\n", "]"}]}], 
    ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Staircase", " ", "plot"}], " ", "*)"}], "\n", 
   RowBox[{"ListStepPlot", "[", 
    RowBox[{"staircasePoints", ",", "\n", "  ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", "  ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<Log[\[Kappa]]\>\"", ",", 
        " ", "\"\<Number of trapped poles\>\""}], "}"}]}], ",", "\n", "  ", 
     RowBox[{
     "PlotLabel", " ", "->", 
      " ", "\"\<Stokes staircase: trapped poles vs. Log \[Kappa]\>\""}], ",", 
     "\n", "  ", 
     RowBox[{"PlotStyle", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"Thick", ",", " ", "Blue"}], "}"}]}], ",", "\n", "  ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"All", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "0.5"}], ",", " ", 
          RowBox[{
           RowBox[{"Max", "[", "nTrappedList", "]"}], " ", "+", " ", "1"}]}], 
         "}"}]}], "}"}]}], ",", "\n", "  ", 
     RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", "\n", "  ", 
     RowBox[{"ImageSize", " ", "->", " ", "600"}], ",", "\n", "  ", 
     RowBox[{"Epilog", " ", "->", " ", 
