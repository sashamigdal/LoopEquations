         "\[Lambda]OptN", ",", "c1", ",", "kSumRange", ",", "logKSumRange", ",",
           "kSumRangeSq", ",", "sdatas"}], "]"}], ";", "\n", 
        "\[IndentingNewLine]", 
        RowBox[{"PrintTemporary", "[", 
         RowBox[{"\"\<Processing \>\"", ",", "numSnaps", 
          ",", "\"\< snapshots on \>\"", ",", "$KernelCount", 
          ",", "\"\< parallel cores...\>\""}], "]"}], ";", 
        "\[IndentingNewLine]", "\n", 
        RowBox[{"(*", 
         RowBox[{"PARALLEL", " ", "OUTER", " ", 
          RowBox[{"LOOP", ":", 
           RowBox[{
           "ParallelTable", " ", "builds", " ", "local", " ", "matrices", " ",
             "across", " ", "CPU", " ", "cores", " ", "and", " ", "Flatten", " ",
             "merges", " ", "them", " ", 
            RowBox[{"instantly", "."}]}]}]}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"allScatteredData", "=", 
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{"ParallelTable", "[", 
            RowBox[{
             RowBox[{"Block", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                "Einterp", ",", "FEv", ",", "weights", ",", "sumFEk2", ",", 
                 "sumFEk2Logk", ",", "meanLogK", ",", "Ln", ",", 
                 "kappaNArray", ",", "HArray"}], "}"}], ",", 
               RowBox[{
                RowBox[{"Einterp", "=", 
                 RowBox[{"Interpolation", "[", 
                  RowBox[{
                   RowBox[{"sdatas", "[", 
                    RowBox[{"[", "n", "]"}], "]"}], ",", 
                   RowBox[{"InterpolationOrder", "->", "3"}], ",", 
                   RowBox[{"Method", "->", "\"\<Spline\>\""}]}], "]"}]}], ";",
                 "\[IndentingNewLine]", 
                RowBox[{"(*", 
                 RowBox[{
                  RowBox[{"1", ")"}], " ", "VECTORIZED", " ", "FE", " ", 
                  "EVALUATION"}], "*)"}], 
                RowBox[{"(*", 
                 RowBox[{
                 "InterpolatingFunction", " ", "natively", " ", "threads", " ",
                   "over", " ", "lists", " ", "in", " ", "modern", " ", 
                  RowBox[{"Mathematica", "!"}]}], "*)"}], 
                "\[IndentingNewLine]", 
                RowBox[{"FEv", "=", 
                 RowBox[{"Einterp", "[", "kSumRange", "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"(*", 
                 RowBox[{
                  RowBox[{"2", ")"}], " ", "VECTORIZED", " ", "MOMENTS", " ", 
                  "via", " ", "listable", " ", "array", " ", "arithmetic", " ",
                   "and", " ", "Total"}], "*)"}], "\[IndentingNewLine]", 
                RowBox[{"weights", "=", 
                 RowBox[{"FEv", "*", "kSumRangeSq"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"sumFEk2", "=", 
                 RowBox[{"Total", "[", "weights", "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"sumFEk2", "!=", "0"}], ",", 
                  RowBox[{
                   RowBox[{"sumFEk2Logk", "=", 
                    RowBox[{"Total", "[", 
                    RowBox[{"weights", "*", "logKSumRange"}], "]"}]}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"meanLogK", "=", 
                    RowBox[{"sumFEk2Logk", "/", "sumFEk2"}]}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"Ln", "=", 
                    RowBox[{"Exp", "[", 
                    RowBox[{"-", "meanLogK"}], "]"}]}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"(*", 
                    RowBox[{
                    RowBox[{"3", ")"}], " ", "VECTORIZED", " ", "H", " ", 
                    "and", " ", "Kappa", " ", "calculation"}], "*)"}], 
                   RowBox[{"kappaNArray", "=", 
                    RowBox[{"kSumRange", "*", "Ln"}]}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"HArray", "=", 
                    RowBox[{
                    RowBox[{"(", "FEv", ")"}], "/", "sumFEk2"}]}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"(*", 
                    RowBox[{
                    RowBox[{"4", ")"}], " ", "Instant", " ", "Transpose", " ",
                     "instead", " ", "of", " ", "AppendTo", " ", "loop"}], 
                    "*)"}], 
                   RowBox[{"(*", 
                    RowBox[{
                    "This", " ", "instantly", " ", "creates", " ", "the", " ",
                     "Nx2", " ", 
                    RowBox[{"matrix", ":", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Log", "[", "k1", "]"}], ",", "H1"}], "}"}], ",", 
                    
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Log", "[", "k2", "]"}], ",", "H2"}], "}"}], ",", 
                    "..."}], "}"}]}]}], "*)"}], 
                   RowBox[{"Transpose", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Log", "[", "kappaNArray", "]"}], ",", "HArray"}],
                     "}"}], "]"}]}], ",", 
                  RowBox[{"{", "}"}]}], " ", 
                 RowBox[{"(*", 
                  RowBox[{
                  "Return", " ", "empty", " ", "if", " ", "sum", " ", "is", " ",
                    "exactly", " ", "0"}], "*)"}], "]"}]}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"n", ",", "1", ",", "numSnaps"}], "}"}]}], "]"}], ",", 
           "1"}], " ", 
          RowBox[{"(*", 
           RowBox[{
           "Flattens", " ", "the", " ", "array", " ", "of", " ", "snapshot", " ",
             "matrices", " ", "into", " ", "a", " ", "single", " ", "list", " ",
             "of", " ", 
            RowBox[{"{", 
             RowBox[{"x", ",", "y"}], "}"}], " ", "pairs"}], "*)"}], "]"}]}], 
        ";", "\[IndentingNewLine]", "\n", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Extracted \>\"", ",", 
          RowBox[{"Length", "[", "allScatteredData", "]"}], 
          ",", "\"\< phase-locked points. Binning...\>\""}], "]"}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{
          "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
            "===", "===", "===", "===", "===", "===", "===", "===", "==="}], 
          "="}], "*)"}], 
        RowBox[{"(*", 
         RowBox[{
         "FAST", " ", "LOGARITHMIC", " ", "BINNING", " ", "AND", " ", "ERROR",
           " ", "CALCULATION"}], "*)"}], 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{
          "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
            "===", "===", "===", "===", "===", "===", "===", "===", "==="}], 
          "="}], "*)"}], 
        RowBox[{"binWidth", "=", "0.02"}], ";", "\n", "\[IndentingNewLine]", 
        RowBox[{"binnedData", "=", 
         RowBox[{"GatherBy", "[", 
          RowBox[{"allScatteredData", ",", 
           RowBox[{
            RowBox[{"Round", "[", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", "binWidth"}], "]"}], 
            "&"}]}], "]"}]}], ";", "\n", "\[IndentingNewLine]", 
        RowBox[{"finalTable", "=", 
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Block", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"lnKappaVals", "=", 
                  RowBox[{"bin", "[", 
                   RowBox[{"[", 
                    RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ",", 
                 RowBox[{"HVals", "=", 
                  RowBox[{"bin", "[", 
                   RowBox[{"[", 
                    RowBox[{"All", ",", "2"}], "]"}], "]"}]}]}], "}"}], ",", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Length", "[", "HVals", "]"}], ">", "5"}], ",", 
                 RowBox[{"(*", 
                  RowBox[{
                  "Require", " ", "enough", " ", "points", " ", "for", " ", 
                   "valid", " ", "statistics"}], "*)"}], 
                 RowBox[{"{", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"Mean", "[", "lnKappaVals", "]"}], ",", 
                    RowBox[{"Mean", "[", "HVals", "]"}], ",", 
                    RowBox[{
                    RowBox[{"StandardDeviation", "[", "HVals", "]"}], "/", 
                    RowBox[{"Sqrt", "[", 
                    RowBox[{"Length", "[", "HVals", "]"}], "]"}]}]}], "}"}], 
                  "}"}], ",", 
                 RowBox[{"{", "}"}]}], "]"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"bin", ",", "binnedData"}], "}"}]}], "]"}], ",", "1"}], 
          "]"}]}], ";", "\n", "\[IndentingNewLine]", 
        RowBox[{"finalTable", "=", 
         RowBox[{"SortBy", "[", 
          RowBox[{"finalTable", ",", "First"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{
          "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
