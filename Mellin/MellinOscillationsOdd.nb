Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SInterp", "[", "q_", "]"}], ":=", 
   RowBox[{
    RowBox[{"df0approx", "[", "q", "]"}], "+", 
    RowBox[{"Log", "[", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{"64", " ", 
        SqrtBox["2"], " ", "\[Pi]", " ", 
        RowBox[{"Csc", "[", 
         FractionBox[
          RowBox[{"\[Pi]", " ", "q"}], "2"], "]"}], "  ", 
        RowBox[{"Zeta", "[", 
         RowBox[{
          FractionBox["13", "2"], "-", "q"}], "]"}]}], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"128", " ", 
           SqrtBox["2"]}], "-", 
          SuperscriptBox["2", "q"]}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", "q"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "15"}], "+", 
          RowBox[{"2", " ", "q"}]}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "5"}], "+", 
          RowBox[{"2", " ", "q"}]}], ")"}], " ", 
        RowBox[{"Zeta", "[", 
         RowBox[{
          FractionBox["15", "2"], "-", "q"}], "]"}]}]]}], "]"}]}]}], 
  ";"}]], "Code",
 CellChangeTimes->{{3.9894894416568937`*^9, 3.9894894841324043`*^9}, {
  3.9922856424261513`*^9, 3.9922856475374527`*^9}, {3.999608510959523*^9, 
  3.999608530364472*^9}},
 CellLabel->"In[66]:=",ExpressionUUID->"2ddd1c0c-eb62-4300-9e2f-fdd7d0577f02"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SInterpLM", "[", "q_", "]"}], ":=", 
   RowBox[{
    RowBox[{"df0lm", "[", 
     RowBox[{
      RowBox[{"Re", "[", "q", "]"}], ",", 
      RowBox[{"Im", "[", "q", "]"}]}], "]"}], " ", "+", 
    RowBox[{"Log", "[", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{"64", " ", 
        SqrtBox["2"], " ", "\[Pi]", " ", 
        RowBox[{"Csc", "[", 
         FractionBox[
          RowBox[{"\[Pi]", " ", "q"}], "2"], "]"}], "  ", 
        RowBox[{"Zeta", "[", 
         RowBox[{
          FractionBox["13", "2"], "-", "q"}], "]"}]}], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"128", " ", 
           SqrtBox["2"]}], "-", 
          SuperscriptBox["2", "q"]}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", "q"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "15"}], "+", 
          RowBox[{"2", " ", "q"}]}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "5"}], "+", 
          RowBox[{"2", " ", "q"}]}], ")"}], " ", 
