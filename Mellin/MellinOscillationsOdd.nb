         RowBox[{"xmax", " ", "-", " ", "xmin"}], ")"}], "/", "2"}], ",", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"ymax", " ", "-", " ", "ymin"}], ")"}], "/", "2"}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"xCenter", " ", "=", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"xmin", " ", "+", " ", "xmax"}], ")"}], "/", "2"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"xmin", " ", "=", " ", 
     RowBox[{"xCenter", " ", "-", " ", "halfRange"}]}], ";", " ", 
    RowBox[{"xmax", " ", "=", " ", 
     RowBox[{"xCenter", " ", "+", " ", "halfRange"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ymin", " ", "=", " ", 
     RowBox[{"-", "halfRange"}]}], ";", " ", 
    RowBox[{"ymax", " ", "=", " ", "halfRange"}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Filter", " ", "visible", " ", "poles", " ", "and", " ", "zeros"}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"visPoles", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{"PolePts", ",", " ", "\n", "  ", 
       RowBox[{
        RowBox[{
         RowBox[{"xmin", " ", "<=", " ", 
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], " ", "<=", " ", "xmax"}], " ", "&&",
          " ", 
         RowBox[{"ymin", " ", "<=", " ", 
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}], " ", "<=", " ", "ymax"}]}], " ", 
        "&"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"visZeros", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{"ZeroPts", ",", " ", "\n", "  ", 
       RowBox[{
        RowBox[{
         RowBox[{"xmin", " ", "<=", " ", 
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], " ", "<=", " ", "xmax"}], " ", "&&",
          " ", 
         RowBox[{"ymin", " ", "<=", " ", 
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}], " ", "<=", " ", "ymax"}]}], " ", 
        "&"}]}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Legend", " ", "labels"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"legendLabels", " ", "=", " ", 
     RowBox[{"Table", "[", "\n", "  ", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"k", " ", "=", " ", 
            RowBox[{"multiIndices", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], ",", " ", "xi", ",", " ", 
           "nTr"}], "}"}], ",", "\n", "    ", 
         RowBox[{
          RowBox[{"xi", " ", "=", " ", 
           RowBox[{"N", "[", 
            RowBox[{"-", 
             RowBox[{"S1", "[", 
              RowBox[{"p0Values", "[", 
               RowBox[{"[", "k", "]"}], "]"}], "]"}]}], "]"}]}], ";", "\n", 
          "    ", 
          RowBox[{"nTr", " ", "=", " ", 
           RowBox[{"nTrappedList", "[", 
            RowBox[{"[", "k", "]"}], "]"}]}], ";", "\n", "    ", 
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"Row", "[", 
             RowBox[{"{", 
              RowBox[{"\"\<\[Xi]=\>\"", ",", " ", 
               RowBox[{"NumberForm", "[", 
                RowBox[{"xi", ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"4", ",", " ", "2"}], "}"}]}], "]"}], ",", 
               " ", "\"\<, N=\>\"", ",", " ", "nTr"}], "}"}], "]"}], ",", " ",
             "12"}], "]"}]}]}], "\n", "  ", "]"}], ",", "\n", "  ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", 
         RowBox[{"Length", "[", "multiIndices", "]"}]}], "}"}]}], "\n", 
      "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Combine", " ", "everything"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"multiThimblePlot", " ", "=", " ", 
     RowBox[{"Show", "[", "\n", "  ", 
      RowBox[{"(*", " ", 
       RowBox[{"Thimble", " ", "curves"}], " ", "*)"}], "\n", "  ", 
      RowBox[{
       RowBox[{"Table", "[", "\n", "    ", 
        RowBox[{
         RowBox[{"ListLinePlot", "[", "\n", "      ", 
          RowBox[{
           RowBox[{"Transpose", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"thimbleCurves", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
