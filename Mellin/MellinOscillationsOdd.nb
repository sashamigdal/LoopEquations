Cell[BoxData[
 RowBox[{
  RowBox[{"df1interp", " ", "=", " ", 
   RowBox[{"Interpolation", "[", "df1values", "]"}]}], ";"}]], "Code",
 CellChangeTimes->{{3.989484192352921*^9, 3.989484195364028*^9}},
 CellLabel->"In[72]:=",ExpressionUUID->"9edb9a07-8c1e-4e62-a2b2-96ec11ddbda0"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"df1approx", "[", "p_", "]"}], " ", ":=", " ", "\n", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x0", ",", "x1", ",", "y0", ",", "y1"}], "}"}], ",", "\n", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x0", ",", "x1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"y0", ",", "y1"}], "}"}]}], "}"}], " ", "=", 
       RowBox[{"df1interp", "[", "\"\<Domain\>\"", "]"}]}], ";", "  ", "\n", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"x0", "<=", 
          RowBox[{"Re", "[", "p", "]"}], " ", "<=", " ", "x1"}], " ", "&&", 
         " ", 
         RowBox[{"y0", "<=", 
          RowBox[{"Im", "[", "p", "]"}], " ", "<=", " ", "y1"}]}], ",", 
        RowBox[{"df1interp", "[", 
         RowBox[{
          RowBox[{"Re", "[", "p", "]"}], ",", 
          RowBox[{"Im", "[", "p", "]"}]}], "]"}], ",", "df1Mean"}], "]"}]}]}],
     "\n", "]"}]}], ";"}]], "Code",
 CellChangeTimes->{{3.989484717611308*^9, 3.989484750698269*^9}, {
  3.989484844929371*^9, 3.989484881801124*^9}, {3.989484936512965*^9, 
