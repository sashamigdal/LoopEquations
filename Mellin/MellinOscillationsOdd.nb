     RowBox[{"Overlay", ":", " ", 
      RowBox[{
      "several", " ", "thimbles", " ", "on", " ", "fixed", " ", 
       "background"}]}]}]}], "  ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], " ", 
   "*)"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Select", " ", "representative", " ", "thimbles", " ", "at", " ", "key", " ",
     "stages"}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Find", " ", "indices", " ", "corresponding", " ", "to", " ", "specific", " ",
     "trapped", " ", "counts"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"multiIndices", " ", "=", " ", 
     RowBox[{"{", "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"idx", " ", "=", " ", 
          RowBox[{"FirstPosition", "[", 
           RowBox[{"nTrappedList", ",", " ", "n"}], "]"}]}], "}"}], ",", "\n",
         "    ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"idx", " ", "=!=", " ", 
           RowBox[{"Missing", "[", "\"\<NotFound\>\"", "]"}]}], ",", "\n", 
          "      ", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"multiIndices", ",", " ", 
            RowBox[{"idx", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], "]"}]}], "\n", "  ", 
       "]"}], ",", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{"n", ",", " ", 
        RowBox[{"{", 
         RowBox[{
         "0", ",", " ", "2", ",", " ", "5", ",", " ", "10", ",", " ", "20", ",",
           " ", "28", ",", " ", "29", ",", " ", "35", ",", " ", "40", ",", 
          " ", "50", ",", " ", "64"}], "}"}]}], "}"}]}], "\n", "]"}], ";"}], 
   "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Colors", " ", "for", " ", "each", " ", "thimble"}], " ", "*)"}], 
   "\n", 
   RowBox[{
    RowBox[{"thimbleColors", " ", "=", " ", 
