               RowBox[{"N", "[", "xi", "]"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"4", ",", " ", "2"}], "}"}]}], "]"}], ",", 
             " ", "\"\<, N=\>\"", ",", " ", "nTr"}], "}"}], "]"}]}]}], "\n", 
        "  ", "]"}], ",", "\n", "  ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", 
         RowBox[{"Length", "[", "multiIndices", "]"}]}], "}"}]}], "\n", 
      "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Combine", " ", "everything"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"multiThimblePlot", " ", "=", " ", 
     RowBox[{"Show", "[", "\n", "  ", 
      RowBox[{"(*", " ", 
       RowBox[{"Thimble", " ", "curves"}], " ", "*)"}], "\n", "  ", 
      RowBox[{
       RowBox[{"Table", "[", "\n", "    ", 
        RowBox[{
         RowBox[{"ListLinePlot", "[", 
          RowBox[{
           RowBox[{"Transpose", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"thimbleCurves", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
              RowBox[{"thimbleCurves", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", " ", "2"}], "]"}], "]"}]}], "}"}], "]"}], ",",
            "\n", "      ", 
           RowBox[{"PlotStyle", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"Thick", ",", " ", 
              RowBox[{"thimbleColors", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], "}"}]}]}], "]"}], ",", "\n", 
         "    ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", 
           RowBox[{"Length", "[", "multiIndices", "]"}]}], "}"}]}], "\n", 
        "  ", "]"}], ",", "\n", "  ", "\n", "  ", 
       RowBox[{"(*", " ", 
        RowBox[{"Poles", ",", " ", "zeros", ",", " ", 
         RowBox[{"reference", " ", "lines"}]}], " ", "*)"}], "\n", "  ", 
       RowBox[{"Graphics", "[", 
        RowBox[{"{", "\n", "    ", 
         RowBox[{"(*", " ", 
          RowBox[{"Poles", ":", " ", 
           RowBox[{"red", " ", "dots"}]}], " ", "*)"}], "\n", "    ", 
         RowBox[{"Red", ",", " ", 
          RowBox[{"PointSize", "[", "0.005", "]"}], ",", " ", 
