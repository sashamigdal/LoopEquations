       RowBox[{"Darker", "[", "Green", "]"}], ",", " ", "Cyan", ",", " ", 
       "Purple", ",", " ", "Magenta", ",", " ", "Brown"}], "}"}]}], ";"}], 
   "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Compute", " ", "all", " ", "thimble", " ", "curves"}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"thimbleCurves", " ", "=", " ", 
     RowBox[{"Table", "[", "\n", "  ", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
