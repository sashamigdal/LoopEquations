Cell[BoxData[
 RowBox[{
  RowBox[{"df0interp", " ", "=", " ", 
   RowBox[{"Interpolation", "[", "df0values", "]"}]}], ";"}]], "Code",
 CellChangeTimes->{{3.989489116280764*^9, 3.9894891200679398`*^9}, 
   3.999608260237966*^9},
 CellLabel->"In[61]:=",ExpressionUUID->"b942c691-a2fa-4357-9a42-b67c71c760b8"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"df0approx", "[", "p_", "]"}], " ", ":=", " ", "\n", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x0", ",", "x1", ",", "y0", ",", "y1"}], "}"}], ",", "\n", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x0", ",", "x1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"y0", ",", "y1"}], "}"}]}], "}"}], " ", "=", 
       RowBox[{"df0interp", "[", "\"\<Domain\>\"", "]"}]}], ";", "  ", "\n", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"x0", "<=", 
          RowBox[{"Re", "[", "p", "]"}], " ", "<=", " ", "x1"}], " ", "&&", 
         " ", 
         RowBox[{"y0", "<=", 
          RowBox[{"Im", "[", "p", "]"}], " ", "<=", " ", "y1"}]}], ",", 
        RowBox[{"df0interp", "[", 
         RowBox[{
          RowBox[{"Re", "[", "p", "]"}], ",", 
          RowBox[{"Im", "[", "p", "]"}]}], "]"}], ",", 
        RowBox[{"df0lm", "[", 
         RowBox[{
          RowBox[{"Re", "[", "p", "]"}], ",", 
          RowBox[{"Im", "[", "p", "]"}]}], "]"}]}], "]"}]}]}], "\n", "]"}]}], 
  ";"}]], "Code",
 CellChangeTimes->{{3.989489171343039*^9, 3.989489231351417*^9}},
 CellLabel->"In[64]:=",ExpressionUUID->"05709407-0b89-4671-9f34-7c142bb6b16f"],

