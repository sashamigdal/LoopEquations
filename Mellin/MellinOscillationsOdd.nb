Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "CountTrappedPoles", "]"}], ";", 
   RowBox[{
    RowBox[{"CountTrappedPoles", "[", 
     RowBox[{"pFunc_", ",", "zZeros_", ",", 
      RowBox[{"xWall_", ":", 
       RowBox[{"-", "8.0`50"}]}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"vals", ",", "reVals", ",", "imVals", ",", 
        RowBox[{"trapped", "=", 
         RowBox[{"{", "}"}]}], ",", "crossings", ",", "tn", ",", "w1", ",", 
        "w2", ",", "reCross"}], "}"}], ",", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Head", "[", "pFunc", "]"}], "=!=", 
          "InterpolatingFunction"}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"{", "}"}], "]"}]}], "]"}], ";", 
       RowBox[{"vals", "=", 
        RowBox[{"pFunc", "[", "\"\<ValuesOnGrid\>\"", "]"}]}], ";", 
       RowBox[{"reVals", "=", 
        RowBox[{"Re", "[", "vals", "]"}]}], ";", 
       RowBox[{"imVals", "=", 
        RowBox[{"Im", "[", "vals", "]"}]}], ";", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"tn", "=", 
           RowBox[{"zZeros", "[", 
            RowBox[{"[", "n", "]"}], "]"}]}], ";", 
          RowBox[{"crossings", "=", "0"}], ";", 
          RowBox[{"Do", "[", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"imVals", "[", 
                   RowBox[{"[", "k", "]"}], "]"}], "<=", "tn"}], "&&", 
                 RowBox[{
                  RowBox[{"imVals", "[", 
                   RowBox[{"[", 
                    RowBox[{"k", "+", "1"}], "]"}], "]"}], ">", "tn"}]}], 
                ")"}], "||", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"imVals", "[", 
                   RowBox[{"[", "k", "]"}], "]"}], ">=", "tn"}], "&&", 
                 RowBox[{
                  RowBox[{"imVals", "[", 
                   RowBox[{"[", 
                    RowBox[{"k", "+", "1"}], "]"}], "]"}], "<", "tn"}]}], 
                ")"}]}], ",", 
              RowBox[{
               RowBox[{"w1", "=", 
                RowBox[{"Abs", "[", 
                 RowBox[{
                  RowBox[{"imVals", "[", 
                   RowBox[{"[", 
                    RowBox[{"k", "+", "1"}], "]"}], "]"}], "-", "tn"}], 
                 "]"}]}], ";", 
               RowBox[{"w2", "=", 
                RowBox[{"Abs", "[", 
                 RowBox[{
                  RowBox[{"imVals", "[", 
                   RowBox[{"[", "k", "]"}], "]"}], "-", "tn"}], "]"}]}], ";", 
               
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"w1", "+", "w2"}], ">", "0"}], ",", 
                 RowBox[{
                  RowBox[{"reCross", "=", 
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"w1", " ", 
                    RowBox[{"reVals", "[", 
                    RowBox[{"[", "k", "]"}], "]"}]}], "+", 
                    RowBox[{"w2", " ", 
                    RowBox[{"reVals", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", "+", "1"}], "]"}], "]"}]}]}], ")"}], "/", 
                    RowBox[{"(", 
                    RowBox[{"w1", "+", "w2"}], ")"}]}]}], ";", 
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{"reCross", "<", "xWall"}], ",", 
                    RowBox[{"crossings", "++"}]}], "]"}]}]}], "]"}]}]}], 
             "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", "1", ",", 
              RowBox[{
               RowBox[{"Length", "[", "vals", "]"}], "-", "1"}]}], "}"}]}], 
           "]"}], ";", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"OddQ", "[", "crossings", "]"}], ",", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"trapped", ",", "n"}], "]"}]}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", "1", ",", 
           RowBox[{"Length", "[", "zZeros", "]"}]}], "}"}]}], "]"}], ";", 
       "trapped"}]}], "]"}]}], ";"}], "\n"}]], "Input",
 CellChangeTimes->{{3.9922873939171886`*^9, 3.992287393919826*^9}},
 CellLabel->
  "In[134]:=",ExpressionUUID->"f4641da3-3010-4017-99f5-8b336b73bb40"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"nRiemann", "=", "200"}], ";", 
   RowBox[{"nDyadic", "=", "80"}], ";", 
   RowBox[{"RiemannPoles", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "8"}], "+", 
       RowBox[{"I", " ", 
        RowBox[{"Im", "[", 
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{"ZetaZero", "[", "n", "]"}], ",", "50"}], "]"}], "]"}]}]}],
       ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "nRiemann"}], "}"}]}], "]"}]}], ";", 
   RowBox[{"Poles", "=", "RiemannPoles"}], ";", 
   RowBox[{"zZeros", "=", 
    RowBox[{"Im", "/@", "RiemannPoles"}]}], ";", 
   RowBox[{"DyadicPoles", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", "17"}], "/", "2"}], "+", 
       RowBox[{"I", " ", "2", " ", "Pi", " ", 
        RowBox[{"k", "/", 
         RowBox[{"Log", "[", "2", "]"}]}]}]}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "1", ",", "nDyadic"}], "}"}]}], "]"}]}], ";", 
   RowBox[{"zDyadic", "=", 
    RowBox[{"Im", "/@", "DyadicPoles"}]}], ";", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Riemann poles = \>\"", ",", 
     RowBox[{"Length", "[", "RiemannPoles", "]"}], 
     ",", "\"\<  dyadic positive poles = \>\"", ",", 
     RowBox[{"Length", "[", "DyadicPoles", "]"}], 
     ",", "\"\<  first dyadic Im = \>\"", ",", 
     RowBox[{"N", "[", 
      RowBox[{"zDyadic", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "]"}], ";"}], "\n"}]], "Input",\

