Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"===", " ", 
     RowBox[{"Thimble", " ", 
      RowBox[{"Animation", ":", " ", 
       RowBox[{"ContourPlot", " ", "background"}]}]}]}], ",", " ", 
