          RowBox[{"i", ",", " ", 
           RowBox[{"Length", "[", "multiIndices", "]"}]}], "}"}]}], "\n", 
        "  ", "]"}], ",", "\n", "  ", "\n", "  ", 
       RowBox[{"(*", " ", 
        RowBox[{"Poles", ",", " ", "zeros", ",", " ", 
         RowBox[{"reference", " ", "lines"}]}], " ", "*)"}], "\n", "  ", 
       RowBox[{"Graphics", "[", 
        RowBox[{"{", "\n", "    ", 
         RowBox[{"(*", " ", 
          RowBox[{"Poles", ":", " ", 
