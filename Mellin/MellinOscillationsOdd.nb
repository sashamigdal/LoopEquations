                  "]"}], ",", " ", "0"}], "}"}], "]"}]}], "}"}], ",", "\n", 
            "      ", 
            RowBox[{"{", 
             RowBox[{"i", ",", " ", 
              RowBox[{"Length", "[", "multiIndices", "]"}]}], "}"}]}], "\n", 
           "    ", "]"}], ",", "\n", "    ", 
          RowBox[{"(*", " ", 
           RowBox[{"Reference", " ", "lines"}], " ", "*)"}], "\n", "    ", 
          RowBox[{"{", 
           RowBox[{"Dashed", ",", " ", "Red", ",", " ", 
            RowBox[{"Thickness", "[", "0.001", "]"}], ",", " ", 
            RowBox[{"Line", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
