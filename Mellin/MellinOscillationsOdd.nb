            RowBox[{"Re", "[", "q", "]"}], ",", " ", 
            RowBox[{"Im", "[", "q", "]"}]}], "}"}], ",", 
          RowBox[{"f1", "/", "f0"}]}], "}"}]}]}], "]"}], ",", 
