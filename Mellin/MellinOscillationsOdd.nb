        RowBox[{"-", "0.5"}], ",", " ", "0.5"}], "}"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"ymin", ",", " ", "ymax"}], "}"}], " ", "=", " ", 
     RowBox[{
      RowBox[{"MinMax", "[", "allIm", "]"}], " ", "+", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "0.5"}], ",", " ", "0.5"}], "}"}]}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Make", " ", "square"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"halfRange", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"xmax", " ", "-", " ", "xmin"}], ")"}], "/", "2"}], ",", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"ymax", " ", "-", " ", "ymin"}], ")"}], "/", "2"}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"xCenter", " ", "=", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"xmin", " ", "+", " ", "xmax"}], ")"}], "/", "2"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"yCenter", " ", "=", " ", "0"}], ";"}], "  ", 
   RowBox[{"(*", " ", 
    RowBox[{"symmetric", " ", "about", " ", "real", " ", "axis"}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"xmin", " ", "=", " ", 
     RowBox[{"xCenter", " ", "-", " ", "halfRange"}]}], ";", " ", 
    RowBox[{"xmax", " ", "=", " ", 
     RowBox[{"xCenter", " ", "+", " ", "halfRange"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ymin", " ", "=", " ", 
     RowBox[{"-", "halfRange"}]}], ";", " ", 
    RowBox[{"ymax", " ", "=", " ", "halfRange"}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Filter", " ", "visible", " ", "poles", " ", "and", " ", "zeros"}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"visPoles", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{"PolePts", ",", " ", "\n", "  ", 
       RowBox[{
        RowBox[{
         RowBox[{"xmin", " ", "<=", " ", 
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], " ", "<=", " ", "xmax"}], " ", "&&",
          " ", 
         RowBox[{"ymin", " ", "<=", " ", 
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}], " ", "<=", " ", "ymax"}]}], " ", 
        "&"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"visZeros", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{"ZeroPts", ",", " ", "\n", "  ", 
       RowBox[{
        RowBox[{
         RowBox[{"xmin", " ", "<=", " ", 
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], " ", "<=", " ", "xmax"}], " ", "&&",
          " ", 
         RowBox[{"ymin", " ", "<=", " ", 
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}], " ", "<=", " ", "ymax"}]}], " ", 
        "&"}]}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Build", " ", "the", " ", "plot"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"thimblePlotLines", " ", "=", " ", 
     RowBox[{"Table", "[", "\n", "  ", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"re", " ", "=", " ", 
            RowBox[{"thimbleCurves", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", " ", "1"}], "]"}], "]"}]}], ",", " ", 
           RowBox[{"im", " ", "=", " ", 
            RowBox[{"thimbleCurves", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", " ", "2"}], "]"}], "]"}]}], ",", "\n", 
           "           ", 
           RowBox[{"k", " ", "=", " ", 
            RowBox[{"multiIndices", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], ",", " ", "p0", ",", " ", "xi",
            ",", " ", "nTr"}], "}"}], ",", "\n", "    ", 
         RowBox[{
          RowBox[{"p0", " ", "=", " ", 
           RowBox[{"p0Values", "[", 
            RowBox[{"[", "k", "]"}], "]"}]}], ";", "\n", "    ", 
          RowBox[{"xi", " ", "=", " ", 
           RowBox[{"-", 
            RowBox[{"S1", "[", "p0", "]"}]}]}], ";", "\n", "    ", 
          RowBox[{"nTr", " ", "=", " ", 
           RowBox[{"nTrappedList", "[", 
            RowBox[{"[", "k", "]"}], "]"}]}], ";", "\n", "    ", 
          RowBox[{"Tooltip", "[", "\n", "      ", 
           RowBox[{
            RowBox[{"ListLinePlot", "[", 
             RowBox[{
              RowBox[{"Transpose", "[", 
               RowBox[{"{", 
                RowBox[{"re", ",", " ", "im"}], "}"}], "]"}], ",", "\n", 
              "        ", 
              RowBox[{"PlotStyle", " ", "->", " ", 
               RowBox[{"{", 
                RowBox[{"Thick", ",", " ", 
                 RowBox[{"thimbleColors", "[", 
                  RowBox[{"[", "i", "]"}], "]"}]}], "}"}]}], ",", "\n", 
              "        ", 
              RowBox[{"PlotRange", " ", "->", " ", "All"}]}], "\n", "      ", 
             "]"}], ",", "\n", "      ", 
            RowBox[{"Row", "[", 
             RowBox[{"{", 
              RowBox[{"\"\<\[Xi]=\>\"", ",", " ", 
               RowBox[{"NumberForm", "[", 
                RowBox[{
                 RowBox[{"N", "[", "xi", "]"}], ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"4", ",", " ", "2"}], "}"}]}], "]"}], ",", 
               " ", "\"\< trapped=\>\"", ",", " ", "nTr"}], "}"}], "]"}]}], 
           "\n", "    ", "]"}]}]}], "\n", "  ", "]"}], ",", "\n", "  ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", 
         RowBox[{"Length", "[", "multiIndices", "]"}]}], "}"}]}], "\n", 
      "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Legend", " ", "labels"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"legendLabels", " ", "=", " ", 
     RowBox[{"Table", "[", "\n", "  ", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"k", " ", "=", " ", 
            RowBox[{"multiIndices", "[", 
