           RowBox[{"Saddle", " ", 
            RowBox[{"points", ":", " ", 
             RowBox[{"small", " ", "colored", " ", "dots"}]}]}], " ", "*)"}], 
          "\n", "    ", 
          RowBox[{"Table", "[", "\n", "      ", 
