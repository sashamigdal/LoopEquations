          RowBox[{"PointSize", "[", "0.004", "]"}], ",", " ", 
          RowBox[{"Point", " ", "/@", " ", "visPoles"}], ",", "\n", "    ", 
          RowBox[{"(*", " ", 
           RowBox[{"Zeros", ":", " ", 
            RowBox[{"green", " ", "dots"}]}], " ", "*)"}], "\n", "    ", 
